<?xml version="1.0"?>
<robot name="mini_robot">
  <link name="base_link">
    <visual><geometry><cylinder radius="0.18" length="0.12"/></geometry></visual>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/>
    <origin xyz="0 0 0.06"/><axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="2"/>
  </joint>
  <link name="link_1"><visual><geometry><box size="0.16 0.16 0.30"/></geometry></visual></link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/>
    <origin xyz="0 0 0.15"/><axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="2"/>
  </joint>
  <link name="link_2"><visual><geometry><box size="0.14 0.14 0.32"/></geometry></visual></link>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/>
    <origin xyz="0 0 0.16"/><axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="10" velocity="2"/>
  </joint>
  <link name="link_3"><visual><geometry><box size="0.12 0.12 0.28"/></geometry></visual></link>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/><child link="link_4"/>
    <origin xyz="0 0 0.14"/><axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="2"/>
  </joint>
  <link name="link_4"><visual><geometry><cylinder radius="0.07" length="0.18"/></geometry></visual></link>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/><child link="link_5"/>
    <origin xyz="0 0 0.09"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10" velocity="2"/>
  </joint>
  <link name="link_5"><visual><geometry><cylinder radius="0.06" length="0.16"/></geometry></visual></link>

  <joint name="joint_6" type="revolute">
    <parent link="link_5"/><child link="tool0"/>
    <origin xyz="0 0 0.08"/><axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="2"/>
  </joint>
  <link name="tool0"><visual><geometry><box size="0.10 0.10 0.10"/></geometry></visual></link>
</robot>
